<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GlassDock</RootNamespace>
    <AssemblyName>Sonara.LiquidGlass</AssemblyName>
    <StartupObject>SonaraGlass.Program</StartupObject>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <EmbeddedResource Include="Veyra/LiquidGlass.hlsl" LogicalName="GlassDock.Rendering.LiquidGlass.hlsl" />
    <EmbeddedResource Include="Veyra/Shaders/*" LogicalName="GlassDock.Rendering.Shaders.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
